<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="collective.tinymceplugins.icons"
    >

  <!-- Publish static files -->
  <plone:static
      directory="static"
      name="collective.tinymceplugins.icons"
      type="plone"
      />

  <browser:view
      name="tinymce-icons-json"
      for="*"
      class=".icons.IconsJsonView"
      permission="zope2.View"
      layer="collective.tinymceplugins.icons.interfaces.IBrowserLayer"
      />

</configure>
